# =============================================================================
# Example environment configuration. Copy to `.env` (and copy the frontend
# line into `frontend/.env.local`) and adjust as needed. All values shown are
# the built-in defaults, so the app runs without any of these set.
# =============================================================================

# --- Backend (FastAPI / Uvicorn) ---------------------------------------------

# Deployment environment label (informational).
ENVIRONMENT=development

# Port Uvicorn listens on.
PORT=5000

# Comma-separated browser origins allowed to call the API (CORS allowlist).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Input guardrails for POST /api/find-words (protect against pathological input).
MAX_RACK_TILES=10
MAX_BLANKS=2
MAX_BOARD_LETTERS=15

# Rate limit for POST /api/find-words (slowapi format, e.g. "30/minute").
RATE_LIMIT_FIND_WORDS=30/minute

# --- Frontend (Next.js) ------------------------------------------------------
# Copy this line into `frontend/.env.local`. It is the backend base URL that the
# Next.js server proxies `/api/*` requests to (see frontend/next.config.mjs).
NEXT_PUBLIC_API_URL=http://localhost:5000
